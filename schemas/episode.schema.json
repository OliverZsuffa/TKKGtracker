{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oliverzsuffa.github.io/TKKGtracker/schemas/episode.schema.json",
  "title": "TKKG main series episode",
  "type": "object",
  "required": [
    "number",
    "title",
    "series",
    "synopsis",
    "cover_url",
    "release_date",
    "release_year",
    "physical_releases",
    "tracks",
    "cast",
    "credits",
    "ratings",
    "sources",
    "last_checked",
    "listening_links"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "const": "TKKG"
    },
    "synopsis": {
      "type": [
        "string",
        "null"
      ]
    },
    "cover_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "physical_releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medium": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "ean": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "source_url"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "character": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "category",
          "value"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "review_count": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "last_checked": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "listening_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "label",
          "url",
          "link_type",
          "source_url"
        ],
        "properties": {
          "service": {
            "const": "official"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "(?i)^https://tkkg\\.lnk\\.to/[^\\s]+$"
          },
          "link_type": {
            "const": "official_hub"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

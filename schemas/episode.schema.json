{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oliverzsuffa.github.io/TKKGtracker/schemas/episode.schema.json",
  "title": "TKKG main series episode",
  "type": "object",
  "required": [
    "number",
    "title",
    "series",
    "synopsis",
    "cover_url",
    "release_date",
    "release_year",
    "physical_releases",
    "tracks",
    "cast",
    "credits",
    "ratings",
    "sources",
    "last_checked",
    "listening_links"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "const": "TKKG"
    },
    "synopsis": {
      "type": [
        "string",
        "null"
      ]
    },
    "cover_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "release_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "release_year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1900,
      "maximum": 2100
    },
    "physical_releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "medium": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "ean": {
            "type": [
              "string",
              "null"
            ]
          },
          "release_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "source_url"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "character": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "category",
          "value"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          },
          "review_count": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "last_checked": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "listening_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "label",
          "url",
          "link_type",
          "source_url"
        ],
        "properties": {
          "service": {
            "const": "official"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "(?i)^https://tkkg\\.lnk\\.to/[^\\s]+$"
          },
          "link_type": {
            "const": "official_hub"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "audio_release": {
      "type": "object",
      "required": [
        "spotify",
        "youtube_music",
        "verification"
      ],
      "properties": {
        "spotify": {
          "type": "object",
          "required": [
            "album_id",
            "url",
            "title",
            "track_count",
            "source_query"
          ],
          "properties": {
            "album_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{22}$"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://open\\.spotify\\.com/album/[A-Za-z0-9]{22}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "track_count": {
              "type": "integer",
              "minimum": 1
            },
            "source_query": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "youtube_music": {
          "type": "object",
          "required": [
            "playlist",
            "tracks",
            "track_count"
          ],
          "properties": {
            "playlist": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "playlist_id": {
                  "type": "string",
                  "pattern": "^(OLAK5uy_[A-Za-z0-9_-]+|PL[A-Za-z0-9_-]+)$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://music\\.youtube\\.com/playlist\\?list="
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "track_count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "playlist_id",
                "url",
                "title",
                "track_count"
              ],
              "additionalProperties": false
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "track_number",
                  "spotify_title",
                  "video_id",
                  "url",
                  "title",
                  "artists",
                  "match_score",
                  "match_evidence"
                ],
                "properties": {
                  "track_number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "spotify_title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "video_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{11}$"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://music\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "artists": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "album": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "duration_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "match_score": {
                    "type": "integer",
                    "minimum": 130
                  },
                  "match_evidence": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "track_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "required": [
            "status",
            "verified_at",
            "method",
            "matched_track_count"
          ],
          "properties": {
            "status": {
              "const": "verified"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "matched_track_count": {
              "type": "integer",
              "minimum": 1
            },
            "playlist_status": {
              "enum": [
                "verified",
                "unavailable"
              ]
            },
            "playlist_error": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
